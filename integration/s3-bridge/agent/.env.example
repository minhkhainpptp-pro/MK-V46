BRIDGE_AGENT_ID=S3-BRIDGE-PRIMARY
BRIDGE_INTEGRATION_KEY=replace-with-random-key
BRIDGE_INTEGRATION_SECRET=replace-with-at-least-32-random-characters
V45_BASE_URL=https://v45.example.com

S3_SQL_SERVER=127.0.0.1
S3_SQL_PORT=1433
S3_SQL_DATABASE=S3IM
S3_SQL_USER=v45_bridge_service
S3_SQL_PASSWORD=replace-me
S3_SQL_ENCRYPT=true
S3_SQL_TRUST_SERVER_CERTIFICATE=false
S3_SQL_CONNECTION_TIMEOUT_MS=15000
S3_SQL_REQUEST_TIMEOUT_MS=120000
S3_SQL_POOL_MAX=5

BRIDGE_RETURN_ENABLED=false
BRIDGE_RETURN_CLAIM_LIMIT=10
BRIDGE_RETURN_LEASE_SECONDS=120
BRIDGE_RETURN_POLL_MS=10000
BRIDGE_STAGED_RETRY_SECONDS=300
BRIDGE_SHUTDOWN_TIMEOUT_MS=30000

BRIDGE_MASTER_ORDER_ENABLED=false
BRIDGE_MASTER_ORDER_POLL_MS=10000
BRIDGE_MASTER_ORDER_BATCH_SIZE=20
